# ============================================================
# Mwarokin Estates — Environment template
# Copy to .env (local tooling) — NEVER commit the filled copy.
# Client-side anon key also goes in app/js/config.js.
# ============================================================

# --- Supabase (project ref: spnerrqumefbuuscumhw) ---
SUPABASE_URL=https://spnerrqumefbuuscumhw.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# --- M-Pesa Daraja (https://developer.safaricom.co.ke) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-online-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://spnerrqumefbuuscumhw.supabase.co/functions/v1/payment-webhook?provider=mpesa

# --- Airtel Money (https://developers.airtel.africa) ---
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=your-client-id
AIRTEL_CLIENT_SECRET=your-client-secret
AIRTEL_CALLBACK_URL=https://spnerrqumefbuuscumhw.supabase.co/functions/v1/payment-webhook?provider=airtel

# --- Flutterwave (https://developer.flutterwave.com) ---
FLW_ENV=sandbox
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_WEBHOOK_HASH=your-webhook-hash
FLW_PUBLIC_KEY=your-flutterwave-public-key

# --- Optional ---
EXCHANGE_RATE_API_KEY=
AI_MIN_SCORE=75

# --- GitHub Actions (set in repo secrets) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_ID

# --- Netlify (only for CLI deploys; CI can use env vars) ---
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
