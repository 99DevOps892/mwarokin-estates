# Mwarokin Estates — environment reference
# Copy to .env and fill in. NEVER commit this file.

# Supabase project
SUPABASE_URL=https://spnerrqumefbuuscumhw.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here # server-side only, never expose to clients

# GitHub secrets (set in repo Settings → Secrets and variables → Actions)
# SUPABASE_URL and SUPABASE_ANON_KEY are injected into js/config.js at deploy time.

# GitLab "2nd brain" mirror
GITLAB_URL=gitlab.com/yourgroup/mwarokin-estates.git
GITLAB_TOKEN=your_gitlab_token

# Safaricom Daraja (M-Pesa) — Supabase Edge Function secrets
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox # or production

# Airtel Money (if integrated)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=

# WhatsApp / SMS / Email worker credentials (message_queue consumers)
WHATSAPP_API_TOKEN=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=MWAROKIN
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=