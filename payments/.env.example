# ============================================================
# .env.example — Required Supabase Edge Function Secrets
# ============================================================
# Run: supabase secrets set KEY=VALUE for each one

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_ENV=sandbox
CALLBACK_URL=https://spnerrqumefbuuscumhw.supabase.co/functions/v1/mpesa-callback

# ── Airtel Money ───────────────────────────────────────────
AIRTEL_USER_ID=your_airtel_user_id
AIRTEL_PASSWORD=your_airtel_password
AIRTEL_SUBSCRIPTION_KEY=your_airtel_subscription_key
AIRTEL_ENV=sandbox
AIRTEL_CALLBACK_URL=https://spnerrqumefbuuscumhw.supabase.co/functions/v1/airtel-callback
